generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  phone            String?   @unique
  gender           Gender?
  dateOfBirth      DateTime?
  city             String?
  province         String?
  clanId           String?
  subClanId        String?
  bio              String?
  bloodGroup       String?
  occupation       String?
  education        String?
  nameTitle        String?
  nickname         String?
  displayName      String?
  cast             String?
  origin           String?
  maritalStatus    String?   @default("SINGLE")
  cnic             String?
  birthPlace       String?
  extendedProfile  Json?
  privacy          Json?
  isVerified       Boolean   @default(false)
  role             Role      @default(USER)
  isActive         Boolean   @default(true)
  isBanned         Boolean   @default(false)
  banReason        String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  loginCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  events          Event[]
  eventRSVPs      EventRSVP[]
  memories        Memory[]
  media           Media[]
  clan            Clan?          @relation(fields: [clanId], references: [id])
  subClan         SubClan?       @relation(fields: [subClanId], references: [id])
  jobProfile      JobProfile?
  occupationProfile OccupationProfile?
  businesses      Business[]
  rishtaProfile   RishtaProfile?
  jobApplications JobApplication[]
  notifications   Notification[]
  reports         Report[]       @relation("Reporter")
  reportedBy      Report[]       @relation("Reported")
  auditLogs       AuditLog[]
  trees           FamilyTree[]     @relation("TreeCreator")
  treeMembers     FamilyMember[]   @relation("MemberUser")
  memberComments  MemberComment[]  @relation("CommentUser")
  memberStories   MemberStory[]    @relation("StoryAuthor")

  @@index([email])
  @@index([clanId])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  device       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  nameUrdu    String?
  description String?
  region      String?
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clans       Clan[]

  @@map("communities")
}

model Clan {
  id          String   @id @default(cuid())
  name        String
  nameUrdu    String?
  description String?
  history     String?  @db.Text
  communityId String
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  community   Community @relation(fields: [communityId], references: [id])
  subClans    SubClan[]
  members     User[]

  @@index([communityId])
  @@map("clans")
}

model SubClan {
  id          String   @id @default(cuid())
  name        String
  nameUrdu    String?
  description String?
  clanId      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clan        Clan    @relation(fields: [clanId], references: [id])
  members     User[]

  @@index([clanId])
  @@map("sub_clans")
}

model Event {
  id               String    @id @default(cuid())
  title            String
  description      String?   @db.Text
  type             EventType
  date             DateTime
  endDate          DateTime?
  location         String?
  latitude         Float?
  longitude        Float?
  hijriDate        String?
  isPublic         Boolean   @default(false)
  isRecurring      Boolean   @default(false)
  recurringPattern String?
  coverImage       String?
  creatorId        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  creator          User      @relation(fields: [creatorId], references: [id])
  rsvps            EventRSVP[]

  @@index([creatorId])
  @@index([date])
  @@index([type])
  @@map("events")
}

model EventRSVP {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RSVPStatus @default(PENDING)
  guests    Int        @default(0)
  note      String?
  createdAt DateTime   @default(now())
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_rsvps")
}

enum EventType {
  BIRTH
  AQEEQA
  BISMILLAH
  KHATAM_QURAN
  ENGAGEMENT
  MEHNDI
  NIKKAH
  BARAAT
  WALIMA
  RUKHSATI
  DEATH
  CHEHLUM
  BARSI
  EID_UL_FITR
  EID_UL_ADHA
  SHAB_E_QADR
  SHAB_E_MERAJ
  MILAD_UN_NABI
  RAMADAN_IFTAR
  FAMILY_REUNION
  GRADUATION
  JOB_CELEBRATION
  WELCOME_HOME
  PANCHAYAT
  INDEPENDENCE_DAY
  PAKISTAN_DAY
  QUAID_E_AZAM_DAY
  IQBAL_DAY
  BASANT
  CHAND_RAAT
  EID_MILAN
  OTHER
}

enum RSVPStatus {
  PENDING
  GOING
  NOT_GOING
  MAYBE
}

model Memory {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  date        DateTime?
  location    String?
  category    MemoryCategory @default(OTHER)
  isPublic    Boolean        @default(false)
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id])
  media       Media[]

  @@index([userId])
  @@map("memories")
}

model Media {
  id        String    @id @default(cuid())
  url       String
  publicId  String?
  type      MediaType
  size      Int?
  mimeType  String?
  memoryId  String?
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  memory    Memory?   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("media")
}

enum MemoryCategory {
  CHILDHOOD
  WEDDING
  GATHERING
  TRAVEL
  ACHIEVEMENT
  OLD_PHOTO
  RELIGIOUS
  FESTIVAL
  DAILY_LIFE
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model JobProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  headline           String?
  summary            String?  @db.Text
  experience         Json?
  education          Json?
  skills             String[]
  languages          String[]
  resumeUrl          String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  expectedSalary     String?
  preferredLocations String[]
  availability       String?  @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
  applications       JobApplication[]

  @@map("job_profiles")
}

model JobPosting {
  id           String    @id @default(cuid())
  businessId   String
  title        String
  description  String    @db.Text
  requirements String?   @db.Text
  type         JobType   @default(FULL_TIME)
  experience   String?
  salaryMin    Int?
  salaryMax    Int?
  currency     String    @default("PKR")
  location     String?
  isRemote     Boolean   @default(false)
  isActive     Boolean   @default(true)
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  business     Business  @relation(fields: [businessId], references: [id])
  applications JobApplication[]

  @@index([businessId])
  @@index([isActive])
  @@map("job_postings")
}

model JobApplication {
  id           String            @id @default(cuid())
  jobPostingId String
  applicantId  String
  profileId    String
  coverLetter  String?           @db.Text
  resumeUrl    String?
  status       ApplicationStatus @default(APPLIED)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  jobPosting   JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicant    User              @relation(fields: [applicantId], references: [id])
  profile      JobProfile        @relation(fields: [profileId], references: [id])

  @@unique([jobPostingId, applicantId])
  @@map("job_applications")
}

model OccupationProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  employmentStatus String?  @default("EMPLOYED")
  jobType          String?  @default("FULL_TIME")
  details          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("occupation_profiles")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  REMOTE
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Business {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?  @db.Text
  industry      String?
  category      String?
  logo          String?
  coverImage    String?
  website       String?
  phone         String?
  email         String?
  address       String?
  city          String?
  province      String?
  latitude      Float?
  longitude     Float?
  socialLinks   Json?
  isVerified    Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  isFamilyOwned Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  jobPostings   JobPosting[]
  reviews       BusinessReview[]

  @@index([userId])
  @@index([isActive])
  @@map("businesses")
}

model BusinessReview {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_reviews")
}

model RishtaProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  age               Int?
  height            String?
  weight            String?
  complexion        String?
  education         String?
  educationDetail   String?
  profession        String?
  income            String?
  sect              String?
  maslak            String?
  castePreference   String?
  cityPreference    String?
  countryPreference String?
  maritalStatus     String?  @default("NEVER_MARRIED")
  children          Int      @default(0)
  about             String?  @db.Text
  familyBackground  String?  @db.Text
  expectations      String?  @db.Text
  photos            String[]
  isActive          Boolean  @default(true)
  isGuardianMode    Boolean  @default(false)
  guardianName      String?
  guardianRelation  String?
  guardianPhone     String?
  isVerified        Boolean  @default(false)
  isPremium         Boolean  @default(false)
  marriageForm      Json?
  viewsCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
  sentRequests      RishtaRequest[] @relation("Sender")
  receivedRequests  RishtaRequest[] @relation("Receiver")

  @@map("rishta_profiles")
}

model RishtaRequest {
  id         String       @id @default(cuid())
  senderId   String
  receiverId String
  message    String?      @db.Text
  status     RishtaStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  sender     RishtaProfile @relation("Sender", fields: [senderId], references: [id])
  receiver   RishtaProfile @relation("Receiver", fields: [receiverId], references: [id])

  @@map("rishta_requests")
}

enum RishtaStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  type       String
  reason     String       @db.Text
  status     ReportStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id])
  reported   User         @relation("Reported", fields: [reportedId], references: [id])

  @@index([status])
  @@map("reports")
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     User?    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}


// ============================================================
// FAMILY TREE MODULE — additive schema (models + enums)
// ============================================================

enum TreeVisibility {
  PRIVATE
  COLLABORATORS
  CLAN_ONLY
  REGISTERED
  PUBLIC
}
enum RelationshipType {
  BIOLOGICAL
  ADOPTED
  STEP
  GUARDIAN
  FOSTER
}
enum MarriageStatus {
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  ENGAGED
}
enum MarriageType {
  NIKKAH
  CIVIL
  COURT
}
enum CollaboratorRole {
  VIEWER
  EDITOR
  ADMIN
  OWNER
}
enum InviteType {
  VIEW
  COLLABORATE
  MERGE
  CLAIM_PROFILE
}
enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}
enum MergeStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
  CANCELLED
}
enum DuplicateStatus {
  PENDING
  CONFIRMED_SAME
  CONFIRMED_DIFFERENT
  MERGED
}
enum LifeEventType {
  BIRTH
  AQEEQA
  BISMILLAH
  KHATAM_QURAN
  SCHOOL_ADMISSION
  GRADUATION
  FIRST_JOB
  ENGAGEMENT
  NIKKAH
  WALIMA
  HAJJ
  UMRAH
  CHILD_BIRTH
  JOB_CHANGE
  PROMOTION
  RETIREMENT
  HOUSE_PURCHASE
  MIGRATION
  ILLNESS
  SURGERY
  DEATH
  FUNERAL
  OTHER
}

model FamilyTree {
  id              String         @id @default(cuid())
  name            String
  description     String?
  isPublic        Boolean        @default(false)
  visibility      TreeVisibility @default(PRIVATE)
  creatorId       String
  rootMemberId    String?
  memberCount     Int            @default(0)
  generationCount Int            @default(0)
  lastModified    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  creator       User                  @relation("TreeCreator", fields: [creatorId], references: [id])
  members       FamilyMember[]
  collaborators TreeCollaborator[]
  invites       TreeInvite[]
  mergeSources  TreeMergeRequest[]    @relation("SourceTree")
  mergeTargets  TreeMergeRequest[]    @relation("TargetTree")
  accessLogs    TreeAccessLog[]
  privacy       TreePrivacySettings?
  versions      TreeVersion[]
  groupPhotos   GroupPhoto[]

  @@index([creatorId])
  @@map("family_trees")
}

model FamilyMember {
  id           String      @id @default(cuid())
  treeId       String
  userId       String?
  firstName    String
  lastName     String
  nickName     String?
  gender       Gender
  dateOfBirth  DateTime?
  dateOfDeath  DateTime?
  isAlive      Boolean     @default(true)
  photo        String?
  birthPlace   String?
  deathPlace   String?
  currentCity  String?
  occupation   String?
  education    String?
  bio          String?     @db.Text
  phone        String?
  email        String?
  generation   Int         @default(1)
  sortOrder    Int         @default(0)
  isPrivate    Boolean     @default(false)
  showInPublic Boolean     @default(true)
  positionX    Float?
  positionY    Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tree             FamilyTree               @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user             User?                    @relation("MemberUser", fields: [userId], references: [id])
  parentRelations  Relationship[]           @relation("ChildOf")
  childRelations   Relationship[]           @relation("ParentOf")
  spouse1Relations Marriage[]               @relation("Spouse1")
  spouse2Relations Marriage[]               @relation("Spouse2")
  comments         MemberComment[]
  lifeEvents       MemberLifeEvent[]
  stories          MemberStory[]
  memberPrivacy    MemberPrivacy?
  photoTags        GroupPhotoTag[]
  verifications    RelationshipVerification[]

  @@index([treeId])
  @@index([treeId, generation])
  @@index([userId])
  @@map("family_members")
}

model Relationship {
  id       String           @id @default(cuid())
  parentId String
  childId  String
  type     RelationshipType @default(BIOLOGICAL)
  treeId   String

  parent FamilyMember @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)
  child  FamilyMember @relation("ChildOf", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
  @@map("relationships")
}

model Marriage {
  id        String         @id @default(cuid())
  spouse1Id String
  spouse2Id String
  treeId    String
  date      DateTime?
  endDate   DateTime?
  location  String?
  status    MarriageStatus @default(MARRIED)
  type      MarriageType   @default(NIKKAH)
  sortOrder Int            @default(0)

  spouse1 FamilyMember @relation("Spouse1", fields: [spouse1Id], references: [id], onDelete: Cascade)
  spouse2 FamilyMember @relation("Spouse2", fields: [spouse2Id], references: [id], onDelete: Cascade)

  @@unique([spouse1Id, spouse2Id])
  @@index([spouse1Id])
  @@index([spouse2Id])
  @@map("marriages")
}

model MemberComment {
  id        String   @id @default(cuid())
  memberId  String
  userId    String
  parentId  String?
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member    FamilyMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user      User             @relation("CommentUser", fields: [userId], references: [id])
  parent    MemberComment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies   MemberComment[]  @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([memberId])
  @@index([parentId])
  @@map("member_comments")
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment MemberComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@map("comment_reactions")
}

model MemberLifeEvent {
  id          String        @id @default(cuid())
  memberId    String
  type        LifeEventType
  title       String
  description String?       @db.Text
  date        DateTime
  location    String?
  photo       String?
  source      String?
  verifiedBy  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@map("member_life_events")
}

model MemberStory {
  id        String   @id @default(cuid())
  memberId  String
  userId    String
  title     String
  content   String   @db.Text
  language  String   @default("ur")
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  author User         @relation("StoryAuthor", fields: [userId], references: [id])

  @@index([memberId])
  @@map("member_stories")
}

model RelationshipVerification {
  id             String   @id @default(cuid())
  relationshipId String?
  marriageId     String?
  memberId       String?
  verifiedBy     String
  verified       Boolean  @default(true)
  note           String?
  createdAt      DateTime @default(now())

  member FamilyMember? @relation(fields: [memberId], references: [id])

  @@map("relationship_verifications")
}

model TreeVersion {
  id        String   @id @default(cuid())
  treeId    String
  userId    String
  action    String
  snapshot  Json
  changes   Json
  createdAt DateTime @default(now())

  tree FamilyTree @relation(fields: [treeId], references: [id])

  @@index([treeId, createdAt])
  @@map("tree_versions")
}

model TreeCollaborator {
  id            String           @id @default(cuid())
  treeId        String
  userId        String
  role          CollaboratorRole @default(VIEWER)
  canEditBranch String?
  addedById     String?
  addedAt       DateTime         @default(now())

  tree FamilyTree @relation(fields: [treeId], references: [id])

  @@unique([treeId, userId])
  @@map("tree_collaborators")
}

model TreeInvite {
  id           String       @id @default(cuid())
  treeId       String
  inviterId    String
  inviteeEmail String?
  inviteePhone String?
  inviteeName  String?
  type         InviteType
  status       InviteStatus @default(PENDING)
  token        String       @unique @default(uuid())
  memberId     String?
  message      String?
  expiresAt    DateTime
  respondedAt  DateTime?
  createdAt    DateTime     @default(now())

  tree FamilyTree @relation(fields: [treeId], references: [id])

  @@index([token])
  @@map("tree_invites")
}

model TreeMergeRequest {
  id            String      @id @default(cuid())
  sourceTreeId  String
  targetTreeId  String
  requesterId   String
  status        MergeStatus @default(PENDING)
  commonMembers Json?
  mergeMap      Json?
  message       String?
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())

  sourceTree FamilyTree @relation("SourceTree", fields: [sourceTreeId], references: [id])
  targetTree FamilyTree @relation("TargetTree", fields: [targetTreeId], references: [id])

  @@map("tree_merge_requests")
}

model DuplicateMatch {
  id         String          @id @default(cuid())
  treeId     String
  member1Id  String
  member2Id  String
  score      Int
  status     DuplicateStatus @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  @@unique([member1Id, member2Id])
  @@map("duplicate_matches")
}

model TreePrivacySettings {
  id              String  @id @default(cuid())
  treeId          String  @unique
  showLiving      Boolean @default(true)
  showFemales     Boolean @default(true)
  showPhotos      Boolean @default(true)
  showDates       Boolean @default(true)
  showPlaces      Boolean @default(true)
  showOccupation  Boolean @default(true)
  showBio         Boolean @default(true)
  showContact     Boolean @default(false)
  watermarkPhotos Boolean @default(true)
  allowDownload   Boolean @default(false)
  allowExport     Boolean @default(false)

  tree FamilyTree @relation(fields: [treeId], references: [id])

  @@map("tree_privacy_settings")
}

model MemberPrivacy {
  id          String  @id @default(cuid())
  memberId    String  @unique
  isHidden    Boolean @default(false)
  hidePhoto   Boolean @default(false)
  hideDates   Boolean @default(false)
  hideBio     Boolean @default(false)
  hideContact Boolean @default(true)

  member FamilyMember? @relation(fields: [memberId], references: [id])

  @@map("member_privacy")
}

model TreeAccessLog {
  id        String   @id @default(cuid())
  treeId    String
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  tree FamilyTree @relation(fields: [treeId], references: [id])

  @@index([treeId])
  @@map("tree_access_logs")
}

model GroupPhoto {
  id         String   @id @default(cuid())
  treeId     String
  url        String
  publicId   String?
  caption    String?
  date       DateTime?
  location   String?
  eventId    String?
  uploadedBy String
  createdAt  DateTime @default(now())

  tree FamilyTree     @relation(fields: [treeId], references: [id])
  tags GroupPhotoTag[]

  @@index([treeId])
  @@map("group_photos")
}

model GroupPhotoTag {
  id       String @id @default(cuid())
  photoId  String
  memberId String
  x        Float
  y        Float

  photo  GroupPhoto   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  member FamilyMember? @relation(fields: [memberId], references: [id])

  @@unique([photoId, memberId])
  @@map("group_photo_tags")
}
